# Copy to .env (git-ignored) and adapt.

# The address users open: https, with a path if the proxy serves it below one
# (https://tools.example.com/ionos-explorer). http only for localhost, to try it out.
PUBLIC_URL=https://explorer.example.com

# The image. Until releases are published, build it with "make image" in the
# repository root and use: IONOS_EXPLORER_IMAGE=ionos-explorer
# IONOS_EXPLORER_IMAGE=ghcr.io/k4ugummi/ionos-explorer:latest

# text, or json for a log collector
# LOG_FORMAT=json

# Fetches running at once over all users
# MAX_FETCHES=2

# compose.caddy.yaml: the host name Caddy gets a certificate for (it must
# resolve to this server, ports 80 and 443 open); the same as in PUBLIC_URL.
# DOMAIN=explorer.example.com
